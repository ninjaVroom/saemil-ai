# Saemil AI bridge configuration (server-side only; never served to the browser).
# Copy to .env and fill only what you use. An empty key or model leaves that provider unavailable.
# Cloud providers are used only when chosen explicitly in mode "cloud"; nothing escalates to them automatically.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Local CLI profiles probed with shutil.which (fixed list; others are ignored).
SAEMIL_CLI_TOOLS=ollama,llm,claude,gemini
# Seconds per CLI job, default 15. Valid range 1-120.
SAEMIL_CLI_TIMEOUT_S=15
# ollama counts as on-device only if `ollama list` shows this exact NAME (include the tag, e.g. llama3.2:latest)
# and the tag does not contain "cloud". Otherwise ollama is reported as not available.
# If OLLAMA_HOST (read from the environment) is set to a non-loopback address, ollama is treated as hosted.
SAEMIL_OLLAMA_MODEL=
# llm needs an explicit model (its default may be a paid API). Set to 1 only if that model runs on this machine.
SAEMIL_LLM_MODEL=
SAEMIL_LLM_ON_DEVICE=
